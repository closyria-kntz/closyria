{
  "name": "@closyria/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsdown --watch --on-success \"node --env-file-if-exists=.env --enable-source-maps dist/index.mjs\"",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@closyria/db": "workspace:*",
    "@closyria/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@closyria/config": "workspace:*",
    "tsdown": "^0.23.1",
    "vitest": "^5.0.5"
  }
}
