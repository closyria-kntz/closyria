# Every morning: restores the newest copy of %i into a throwaway database and compares it with the live one.
# Runs as postgres (creates and drops the throwaway database); the private key only reaches this service.
[Unit]
Description=Closyria backup check (%i)
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=closyria-backup-alert@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/closyria/%i.env
EnvironmentFile=/etc/closyria/backup.env
LoadCredential=age-identity:/etc/closyria/backup.key
Environment=BACKUP_AGE_IDENTITY=%d/age-identity
Environment=BACKUP_ADMIN_URL=postgresql:///postgres?host=/var/run/postgresql
Environment=TZ=UTC
Environment=HOME=/tmp
ExecStart=/usr/local/bin/closyria-backup-check %i
TimeoutStartSec=1h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
UMask=0077
